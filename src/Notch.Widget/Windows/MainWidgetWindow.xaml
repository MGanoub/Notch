<Window x:Class="Notch.Widget.Windows.MainWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Notch.Widget.Windows"
        mc:Ignorable="d"
        Title="Notch" Height="220" Width="260"
        Topmost="True"
        Left="40" Top="40"
        Loaded="MainWidgetWindow_Loaded">
    <StackPanel Margin="12">
        <TextBlock Text="Task" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="TaskComboBox" Margin="0,0,0,10"
                  DisplayMemberPath="Title"
                  SelectionChanged="TaskComboBox_SelectionChanged"></ComboBox>
        <TextBlock x:Name="StatusText" Margin="0,0,0,10"/>
        <Button x:Name="StartStopButton" Content="Start" Click="StartStopButton_Click"/>
        
        <TextBlock Text="Subtasks" FontWeight="Bold" Margin="0,0,0,6"/>
        <ListBox x:Name="SubtaskListBox"
                 DisplayMemberPath="Title"
                 SelectionChanged="SubtaskListBox_SelectionChanged"/>
    </StackPanel>
</Window>
