<Window x:Class="Notch.Widget.Windows.MainWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:enums="clr-namespace:Notch.Shared.Enums;assembly=Notch.Shared"
        xmlns:local="clr-namespace:Notch.Widget.Windows"
        mc:Ignorable="d"
        Title="Notch" Height="220" Width="260"
        Topmost="True"
        Left="40" Top="40"
        ResizeMode="NoResize" 
        SizeToContent="Height"
        WindowStyle="None"
        Loaded="MainWidgetWindow_Loaded"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16">
        <StackPanel>
            <Grid x:Name="HeaderGrid" Margin="0,0,0,14"
                  Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <UniformGrid Rows="3" Columns="2" Width="8" Height="12"
                                 Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.6">
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                        <Ellipse Width="3" Height="3" Fill="{StaticResource MutedTextBrush}"/>
                    </UniformGrid>
                    <TextBlock Text="Notch" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE711;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
           
        <ComboBox x:Name="TaskComboBox" Margin="0,0,0,6"
                  SelectionChanged="TaskComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
            <Border Background="{StaticResource InsetBrush}" CornerRadius="8"
                    Padding="12,6" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Status" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" CornerRadius="6" Padding="9,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource InsetBrush}">
                            <TextBlock x:Name="StatusText" Text="—" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="DoneButton" Margin="6,0,0,0"
                                Style="{StaticResource IconButton}"
                                Content="&#xE73E;" ToolTip="Mark done"
                                IsEnabled="False"
                                Click="DoneButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        <Button x:Name="StartStopButton" Content="Start" Click="StartStopButton_Click" 
                Style="{StaticResource ActionButton}" 
                Background="{StaticResource SuccessBrush}"/>
        
        <StackPanel x:Name="SubtasksPanel" Visibility="Collapsed">
    <TextBlock Text="Subtasks" FontSize="11" FontWeight="Bold"
               Margin="0,10,0,6" Foreground="{StaticResource MutedTextBrush}"/>

            <ItemsControl x:Name="SubtaskItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Background="{StaticResource InsetBrush}"
                                CornerRadius="6" Padding="8,4" Margin="0,0,0,6" Cursor="Hand"
                                MouseLeftButtonUp="SubtaskRow_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Marker" Grid.Column="0" Text="○" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="RowTitle" Grid.Column="1" Text="{Binding Title}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                        Content="&#xE73E;" ToolTip="Mark done"
                                        Click="SubtaskDone_Click"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="{x:Static enums:NotchStatus.InProgress}">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBgBrush}"/>
                                <Setter TargetName="Marker" Property="Text" Value="●"/>
                                <Setter TargetName="Marker" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}"
                                         Value="{x:Static enums:NotchStatus.Done}">
                                <Setter TargetName="Marker" Property="Text" Value="✓"/>
                                <Setter TargetName="Marker" Property="Foreground" Value="{StaticResource DoneBrush}"/>
                                <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Setter TargetName="RowTitle" Property="TextDecorations" Value="Strikethrough"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <!-- Footer: divider line + link with icon -->
        <Border BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">
            <TextBlock HorizontalAlignment="Center" FontSize="11">
                <Hyperlink Click="OpenWebApp_Click">
                    <Run FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;"/>
                    <Run Text=" Open full app"/>
                </Hyperlink>
            </TextBlock>
        </Border>
    </StackPanel>
    </Border>
</Window>
